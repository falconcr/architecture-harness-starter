{
  "name": "architecture-harness-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repo demo de harness engineering: los agentes proponen, los gates deterministas deciden, los humanos son duenos de lo irreversible.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/http/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/http/index.js",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "depcruise src --config .dependency-cruiser.js",
    "arch:graph": "depcruise src --config .dependency-cruiser.js --output-type dot",
    "policy": "bash scripts/conftest.sh",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run arch:check && npm run policy"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.9.2",
    "dependency-cruiser": "17.0.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.0.5"
  }
}
