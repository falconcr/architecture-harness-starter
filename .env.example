# Variables de entorno del servicio orders.
#
# Este archivo documenta la configuracion SIN secretos y es el unico .env* que
# los agentes pueden leer (ver .claude/hooks/guard-secret-read.sh).
# Un .env real nunca se commitea (ADR-003).

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=dev

# Porcentaje de requests de negocio que devuelven 500 (0 a 1).
# Existe SOLO para la demo del canary (Acto 2). En una build sana vale 0.
FAULT_RATE=0
